# En local, laisse ces deux lignes vides : Vite envoie /api vers Django sur le port 8000.
# Sur Vercel, tant que le backend n'a pas d'adresse, ne règle rien : le site montre
# les données de démonstration déjà dans le frontend.
# Quand le backend est en ligne, dans les variables Vercel :
#   VITE_DATA_SOURCE=api
#   VITE_API_BASE=https://adresse-du-backend
#   VITE_AGENT_SOURCE=backend
# puis relance le déploiement. Vite fige ces valeurs au moment du build.
# VITE_API_BASE ne se termine pas par un /.

VITE_DATA_SOURCE=
VITE_API_BASE=
VITE_AGENT_SOURCE=backend
VITE_AGENT_URL=
VITE_AGENT_TOKEN=
